@model IEnumerable<Company_MVC.Models.Employee>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<partial name="_EmployeeTable" model="Model" />

<label for="employee-search">Search: </label>
<input type="text" id="employee-search"/>

<table class="table" id="employee-search-results">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Department ID</th>
            <th>Salary</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
    </tbody>
</table>

<script>
    let searchInput = document.querySelector("#employee-search");
    let tableBody = document.querySelector("#employee-search-results")

    searchInput.addEventListener("input", async (e) => {
        let name = e.target.value;

        let response = await fetch(`/Employee/Search?name=${name}`);

        let employees = await response.json();

        tableBody.innerHTML = ''
        employees.forEach(employee => {
            tableBody.innerHTML += `
                <tr>
                    <td>${employee.name}</td>
                    <td>${employee.age}</td>
                    <td>${employee.departmentId}</td>
                    <td>${employee.salary}</td>
                    <td>
                        <a href="/Employee/Edit/${employee.id}">
                            Edit
                        </a>
                        <a href="/Employee/Delete/${employee.id}">
                            Delete
                        </a>
                        <a href="/Employee/Details/${employee.id}">
                            Details
                        </a>
                    </td>
                </tr>
            `;
        });
    });
</script>